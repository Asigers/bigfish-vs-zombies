{
  "name": "bigfish-vs-zombies",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "node src/main.mjs",
    "sim": "node src/main.mjs --engine=sim --levels=10 --tick=250 --quiet",
    "sim:verbose": "node src/main.mjs --engine=sim --levels=10 --tick=250",
    "test:native": "bash scripts/native-check.sh",
    "check": "npm test && npm run test:native"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0"
  }
}
